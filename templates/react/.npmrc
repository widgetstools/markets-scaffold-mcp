; Force npm to install ONLY from local libs/*.tgz tarballs.
; Never contact the public registry or any corporate artifactory.
offline=true
prefer-offline=true
legacy-peer-deps=true

; Block network side-channels (telemetry, audit, funding, update checks)
audit=false
fund=false
update-notifier=false

; Hard-fail if anything ever tries to reach a registry — this URL is unreachable.
registry=http://localhost:0/
